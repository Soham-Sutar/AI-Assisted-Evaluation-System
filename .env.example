APP_ENV=development
PROJECT_NAME=EvalAI

# PostgreSQL Configuration
POSTGRES_USER=evalai
POSTGRES_PASSWORD=evalai
POSTGRES_DB=evalai
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://evalai:evalai@postgres:5432/evalai

# Security
JWT_SECRET=development-secret-key-change-in-production

# Demo Seed Passwords (Required for database seed script)
ADMIN_SEED_PASSWORD=replace-with-admin-seed-password
FACULTY_SEED_PASSWORD=replace-with-faculty-seed-password
REVIEWER_SEED_PASSWORD=replace-with-reviewer-seed-password

# Storage
STORAGE_PATH=/app/storage
MAX_UPLOAD_MB=20

# OCR & AI
OCR_LANGUAGE=eng
AI_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
AI_DEVICE=cpu
AI_SEMANTIC_WEIGHT=0.5
AI_KEYPOINT_WEIGHT=0.5

# Discrepancy & Moderation
DISCREPANCY_ABSOLUTE_THRESHOLD=2.0
DISCREPANCY_RELATIVE_THRESHOLD=0.20
